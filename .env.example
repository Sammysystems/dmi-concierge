# ── AI ────────────────────────────────────────────────────────────────────────
# Two chat providers, tried in order, so one quota cannot take the desk down.
# AI_PROVIDER: hybrid (Gemini then NVIDIA) | nvidia (NVIDIA then Gemini) | gemini.
# Embeddings always use Gemini.
AI_PROVIDER=hybrid
GEMINI_API_KEY=your_gemini_key
NVIDIA_API_KEY=your_nvidia_nim_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=openai/gpt-oss-20b
# Reasoning budget for NVIDIA reasoning models: low | medium | high (low = fast).
NVIDIA_REASONING_EFFORT=low
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
LLM_MODEL=gemini-3.6-flash
LLM_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.5-flash

# ── RAG ───────────────────────────────────────────────────────────────────────
TOP_K=4
SIMILARITY_FLOOR=0.25

# ── Inventory (InsForge Postgres) ─────────────────────────────────────────────
INSFORGE_URL=https://your-project.us-east.insforge.app
INSFORGE_API_KEY=your_insforge_project_key

# ── Studio ────────────────────────────────────────────────────────────────────
# The default slug this deploy points at (a folder under src/content/ and a
# corpus file under src/data/). The studio's own site lives at /p/<slug>.
PROPERTY_SLUG=dmi
# Fallback WhatsApp number (digits only) when a profile omits contact.whatsapp.
WHATSAPP_NUMBER=2349013962323

# ── Email (Resend) ────────────────────────────────────────────────────────────
# With the shared onboarding@resend.dev sender, Resend only delivers to the
# account owner until a sending domain is verified. MAIL_OVERRIDE_TO redirects
# every mail to one inbox (the true recipient is named in the body) until then.
RESEND_API_KEY=your_resend_key
EMAIL_FROM=onboarding@resend.dev
NOTIFY_EMAIL=studio@example.com
# Optional: redirect all mail to a single test inbox while onboarding.
# MAIL_OVERRIDE_TO=you@example.com
